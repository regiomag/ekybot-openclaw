      setChannels(prev => {
        const updated = prev.filter(ch => ch.key !== channelKey);
        setCachedData('chat_channels', updated, userIdRef.current || undefined);
        return updated;
      });
      if (activeChannelKey === channelKey) setActiveChannelKey('general');
