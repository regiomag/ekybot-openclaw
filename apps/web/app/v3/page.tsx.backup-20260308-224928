    const allowedExtensions = ['.txt', '.md', '.json', '.log', '.rb', '.py', '.js', '.ts', '.jsx', '.tsx', '.html', '.css', '.xml', '.yaml', '.yml', '.csv', '.pdf', '.mp4', '.webm', '.mov', '.m4v'];
