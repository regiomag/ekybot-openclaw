import { NextRequest, NextResponse } from 'next/server';
import { auth } from '@clerk/nextjs/server';
import { PrismaClient } from '@prisma/client';
import { callProvider, getProviderApiKey, createOpenAICompatibleStream } from '@/lib/llm-providers';
// DISABLED: Queue system doesn't work on Vercel serverless
// import { isAgentBusy, markAgentBusy, markAgentIdle, getAgentState } from '@/lib/agent-queue';

const prisma = new PrismaClient();

/**
 * Proxy endpoint for OpenClaw Gateway
 * Uses /v1/responses endpoint for image support
 * Tracks real token usage and costs
 */

// Tarifs par modèle ($ per 1K tokens) - Updated June 2025
const MODEL_PRICING: Record<string, { input: number; output: number }> = {
  // === ANTHROPIC ===
  // Claude 4 Opus (flagship)
  'anthropic/claude-opus-4': { input: 0.015, output: 0.075 },
  'claude-opus-4': { input: 0.015, output: 0.075 },
  // Claude 4 Sonnet
  'anthropic/claude-sonnet-4': { input: 0.003, output: 0.015 },
  'claude-sonnet-4': { input: 0.003, output: 0.015 },
  // Claude 3.7 Sonnet
  'anthropic/claude-3.7-sonnet': { input: 0.003, output: 0.015 },
  'claude-3.7-sonnet': { input: 0.003, output: 0.015 },
  // Claude 3.5 Sonnet
  'anthropic/claude-3.5-sonnet': { input: 0.006, output: 0.03 },
  'claude-3-5-sonnet': { input: 0.003, output: 0.015 },
  // Claude 3.5 Haiku
  'anthropic/claude-3.5-haiku': { input: 0.0008, output: 0.004 },
  'claude-3-5-haiku': { input: 0.0008, output: 0.004 },
  // Claude 3 Haiku
  'anthropic/claude-3-haiku': { input: 0.00025, output: 0.00125 },

  // === OPENAI ===
  // GPT-4.1 series
  'openai/gpt-4.1': { input: 0.002, output: 0.008 },
  'openai/gpt-4.1-mini': { input: 0.0004, output: 0.0016 },
  'openai/gpt-4.1-nano': { input: 0.0001, output: 0.0004 },
  // GPT-4o series
  'openai/gpt-4o': { input: 0.0025, output: 0.01 },
  'gpt-4o': { input: 0.0025, output: 0.01 },
  'openai/gpt-4o-mini': { input: 0.00015, output: 0.0006 },
  'gpt-4o-mini': { input: 0.00015, output: 0.0006 },
  // o-series reasoning
  'openai/o3': { input: 0.002, output: 0.008 },
  'openai/o3-mini': { input: 0.0011, output: 0.0044 },
  'openai/o4-mini': { input: 0.0011, output: 0.0044 },
  'openai/o1': { input: 0.015, output: 0.06 },

  // === GOOGLE ===
  'google/gemini-2.5-pro-preview-05-06': { input: 0.00125, output: 0.01 },
  'google/gemini-2.0-flash-001': { input: 0.0001, output: 0.0004 },
  'google/gemini-2.0-flash-lite-001': { input: 0.000075, output: 0.0003 },

  // === DEEPSEEK ===
  'deepseek/deepseek-r1': { input: 0.0007, output: 0.0025 },
  'deepseek/deepseek-chat': { input: 0.00032, output: 0.00089 },

  // === META LLAMA ===
  'meta-llama/llama-3.3-70b-instruct': { input: 0.0001, output: 0.00032 },
  'meta-llama/llama-4-maverick': { input: 0.00015, output: 0.0006 },
  'meta-llama/llama-4-scout': { input: 0.00008, output: 0.0003 },

  // === MISTRAL ===
  'mistralai/mistral-large': { input: 0.002, output: 0.006 },
  'mistralai/mistral-medium-3': { input: 0.0004, output: 0.002 },

  // === xAI ===
  'x-ai/grok-3-beta': { input: 0.003, output: 0.015 },
  'x-ai/grok-3-mini-beta': { input: 0.0003, output: 0.0005 },

  // Legacy aliases
  'claude-opus-4-5': { input: 0.015, output: 0.075 },
  'gpt-4': { input: 0.03, output: 0.06 },
  'gpt-4-turbo': { input: 0.01, output: 0.03 },

  // Default fallback
  'default': { input: 0.003, output: 0.015 },
};

function calculateCost(model: string, inputTokens: number, outputTokens: number): number {
  // Find matching pricing (try exact match, then partial match)
  let pricing = MODEL_PRICING[model];
  if (!pricing) {
    // Try partial match
    const modelLower = model.toLowerCase();
    for (const [key, value] of Object.entries(MODEL_PRICING)) {
      if (modelLower.includes(key.toLowerCase()) || key.toLowerCase().includes(modelLower)) {
        pricing = value;
        break;
      }
    }
  }
  pricing = pricing || MODEL_PRICING['default'];
  
  const inputCost = (inputTokens / 1000) * pricing.input;
  const outputCost = (outputTokens / 1000) * pricing.output;
  return inputCost + outputCost;
}

async function saveUsage(userId: string, model: string, inputTokens: number, outputTokens: number, channelKey?: string, agentId?: string) {
  const totalTokens = inputTokens + outputTokens;
  const cost = calculateCost(model, inputTokens, outputTokens);
  
  try {
    await prisma.apiUsage.create({
      data: {
        userId,
        model,
        tokens: totalTokens,
        cost,
        channelKey: channelKey || null,
        agentId: agentId || null,
      },
    });
    
    // Update agent's budgetUsed if applicable
    if (agentId) {
      await prisma.agent.update({
        where: { id: agentId },
        data: { budgetUsed: { increment: cost } }
      });
    }
    
    console.log(`[Usage] Saved: ${model} - ${totalTokens} tokens - $${cost.toFixed(6)}${channelKey ? ` [${channelKey}]` : ''}${agentId ? ` (agent: ${agentId})` : ''}`);
  } catch (error) {
    console.error('[Usage] Failed to save:', error);
  }
}

// Get channel with agent info
async function getChannelWithAgent(userId: string, channelKey?: string) {
  if (!channelKey) return null;
  
  try {
    const channel = await prisma.channel.findUnique({
      where: { userId_key: { userId, key: channelKey } },
      include: { agent: true }
    });
    return channel;
  } catch (error) {
    console.error('[Chat] Failed to get channel:', error);
    return null;
  }
}

export async function POST(request: NextRequest) {
  // Declare agentId at function scope for finally block access
  let agentId: string | null = null;
  
  try {
    const body = await request.json();
    const { gatewayUrl, token, gatewayToken, messages, stream, image, message: singleMessage, channelKey, sourceChannelKey, openclawAgentId: explicitAgentId } = body;
    const authToken = token || gatewayToken; // Support both names
    
    // If sourceChannelKey is provided, this is a cross-channel CC request
    // The caller will handle saving the response, so we just return the content
    const isCrossChannelRequest = !!sourceChannelKey;
    
    // FIX: For CC requests, use explicit agent ID if provided (don't rely on channel lookup)
    const ccAgentId = explicitAgentId || null;

    if (!gatewayUrl) {
      return NextResponse.json(
        { error: 'gatewayUrl is required' },
        { status: 400 }
      );
    }

    // Support both "messages" (array) and "message" (string) formats
    let messageArray = messages || (singleMessage ? [{ role: 'user', content: singleMessage }] : []);
    
    // Limit context size to prevent session overflow (keep last N messages)
    const MAX_CONTEXT_MESSAGES = 50;
    if (messageArray.length > MAX_CONTEXT_MESSAGES) {
      console.log(`[Chat] Trimming context from ${messageArray.length} to ${MAX_CONTEXT_MESSAGES} messages`);
      // Always keep the first message (system/instructions) if present
      const firstMsg = messageArray[0];
      const isSystemFirst = firstMsg?.role === 'system';
      if (isSystemFirst) {
        messageArray = [firstMsg, ...messageArray.slice(-(MAX_CONTEXT_MESSAGES - 1))];
      } else {
        messageArray = messageArray.slice(-MAX_CONTEXT_MESSAGES);
      }
    }
    
    if (messageArray.length === 0) {
      return NextResponse.json(
        { error: 'messages or message is required' },
        { status: 400 }
      );
    }

    // Get authenticated user
    let userId: string | null = null;
    let clerkId: string | null = null;
    try {
      const authResult = await auth();
      clerkId = authResult.userId;
      console.log('[Chat] auth() clerkId:', clerkId);
      if (clerkId) {
        const user = await prisma.user.findUnique({ where: { clerkId } });
        userId = user?.id || null;
        console.log('[Chat] Found user from auth():', userId);
      }
    } catch (e) {
      console.log('[Chat] No auth context:', e);
    }
    
    // Fallback: get userId from header (for when auth() doesn't work on Vercel)
    if (!userId) {
      const headerClerkId = request.headers.get('x-clerk-user-id');
      console.log('[Chat] Fallback header x-clerk-user-id:', headerClerkId);
      if (headerClerkId) {
        const user = await prisma.user.findUnique({ where: { clerkId: headerClerkId } });
        userId = user?.id || null;
        console.log('[Chat] Found user from header:', userId);
      }
    }
    
    // Get channel and its assigned agent
    let channelAgent: { id: string; provider: string; apiKey: string | null; openclawAgentId: string | null; model: string; budget: number | null; budgetUsed: number } | null = null;
    console.log(`[Chat] Looking for channel: userId=${userId}, channelKey=${channelKey}`);
    if (userId && channelKey) {
      const channel = await getChannelWithAgent(userId, channelKey);
      console.log(`[Chat] Channel found:`, channel ? { id: channel.id, agentId: channel.agentId, hasAgent: !!channel.agent } : 'null');
      if (channel?.agent) {
        channelAgent = channel.agent;
        console.log(`[Chat] Channel ${channelKey} has agent: ${channelAgent.id} (openclawAgentId: ${channelAgent.openclawAgentId})`);
        
        // Check agent budget
        if (channelAgent.budget !== null && channelAgent.budgetUsed >= channelAgent.budget) {
          return NextResponse.json(
            { error: `Budget de l'agent épuisé ($${channelAgent.budgetUsed.toFixed(2)} / $${channelAgent.budget.toFixed(2)})` },
            { status: 402 }
          );
        }
      }
    }

    // ============================================
    // AGENT QUEUE LOGIC
    // ============================================
    // Check if agent is busy - if so, return queued status
    // Each agent has its own queue, allowing parallel processing across agents
    agentId = channelAgent?.id || null;
    // DISABLED: Queue system doesn't work on Vercel serverless (in-memory state not shared)
    // const skipQueue = body.skipQueue === true;
    const skipQueue = true; // Always skip queue until we have a proper solution (Redis, etc.)
    
    // DISABLED: Queue system - commented out entirely
    // if (!skipQueue && isAgentBusy(agentId)) {
    //   const state = getAgentState(agentId);
    //   console.log(`[Chat] Agent "${agentId || 'default'}" is BUSY (queue: ${state.queueLength}), returning queued status`);
    //   return NextResponse.json({
    //     queued: true,
    //     position: state.queueLength + 1,
    //     agentId: agentId || 'default',
    //     message: `L'agent traite une autre requête. Position dans la file: ${state.queueLength + 1}`,
    //     channelKey,
    //   }, { status: 202 });
    // }
    // const requestId = `req_${Date.now()}_${Math.random().toString(36).slice(2, 8)}`;
    // markAgentBusy(agentId, requestId, channelKey);
    
    // Determine if we should use direct provider call or OpenClaw Gateway
    // Direct provider: agent has provider set and NO openclawAgentId (pure LLM call)
    // Gateway: has openclawAgentId (needs OpenClaw tools/memory) or no agent
    
    const effectiveModel = body.model || channelAgent?.model || 'claude-sonnet-4-20250514';
    
    // Check if this agent uses a direct provider (not OpenClaw gateway)
    const agentProvider = channelAgent?.provider; // 'openai' | 'anthropic' | 'google'
    const useDirectProvider = agentProvider && 
                              agentProvider !== 'openclaw' && 
                              !channelAgent?.openclawAgentId;
    
    // ============================================
    // DIRECT PROVIDER CALL (OpenAI, Anthropic, Google)
    // ============================================
    if (useDirectProvider && userId) {
      console.log(`[Chat] Using DIRECT provider: ${agentProvider} (model: ${effectiveModel})`);
      
      // Get API key for this provider
      const apiKey = await getProviderApiKey(userId, agentProvider);
      if (!apiKey) {
        return NextResponse.json(
          { error: `Clé API ${agentProvider} non configurée. Va dans Paramètres → Clés API pour l'ajouter.` },
          { status: 400 }
        );
      }
      
      try {
        // Call provider directly
        const result = await callProvider(
          agentProvider,
          apiKey,
          effectiveModel,
          messageArray,
          stream || false
        );
        
        // Handle streaming response
        if (stream && result instanceof ReadableStream) {
          const transformedStream = createOpenAICompatibleStream(result, agentProvider, effectiveModel);
          
          return new Response(transformedStream, {
            headers: {
              'Content-Type': 'text/event-stream',
              'Cache-Control': 'no-cache',
              'Connection': 'keep-alive',
            },
          });
        }
        
        // Non-streaming response
        const llmResponse = result as { content: string; model: string; usage?: { input_tokens: number; output_tokens: number } };
        
        // Save usage
        if (llmResponse.usage) {
          await saveUsage(
            userId,
            llmResponse.model || effectiveModel,
            llmResponse.usage.input_tokens,
            llmResponse.usage.output_tokens,
            channelKey,
            channelAgent?.id
          );
        }
        
        // Return in OpenAI format for compatibility
        return NextResponse.json({
          choices: [{
            message: {
              role: 'assistant',
              content: llmResponse.content,
            }
          }],
          model: llmResponse.model || effectiveModel,
          usage: llmResponse.usage,
        });
        
      } catch (error: any) {
        console.error(`[Chat] Direct provider error:`, error);
        return NextResponse.json(
          { error: `Erreur ${agentProvider}: ${error.message}` },
          { status: 500 }
        );
      }
    }
    
    // ============================================
    // OPENCLAW GATEWAY (for tools, memory, etc.)
    // ============================================
    const httpUrl = gatewayUrl
      .replace(/^ws:\/\//, 'http://')
      .replace(/^wss:\/\//, 'https://');
    
    // Get OpenClaw agent ID: explicit (CC) > channel agent > default 'main'
    const openclawAgentId = ccAgentId || channelAgent?.openclawAgentId || 'main';
    console.log(`[Chat] ROUTING: channelKey=${channelKey} → openclawAgentId=${openclawAgentId} (explicit=${ccAgentId}, channelAgent=${channelAgent ? 'found' : 'null'})`);
    
    // For cross-channel CC requests: use source channel for session, but target agent for processing
    // This way the agent responds in the conversation where @mention happened
    const sessionChannelKey = sourceChannelKey || channelKey || 'default';
    if (isCrossChannelRequest) {
      console.log(`[Chat] CROSS-CHANNEL CC: agent=${openclawAgentId} responding in session for #${sourceChannelKey} (triggered from #${channelKey})`);
    }
    
    // Always use /v1/responses for full agent capabilities (tools, memory, etc.)
    const url = `${httpUrl}/v1/responses`;
    
    const headers: Record<string, string> = {
      'Content-Type': 'application/json',
      'x-openclaw-agent-id': openclawAgentId,
      'x-openclaw-session-key': `agent:${openclawAgentId}:${sessionChannelKey}`,  // Use source channel for CC
      'ngrok-skip-browser-warning': 'true',
      'User-Agent': 'Ekybot/1.0',
    };
    
    console.log(`[Chat] Channel "${channelKey}" → OpenClaw agent "${openclawAgentId}" (session: ${sessionChannelKey}, model: ${effectiveModel})`);
    
    if (authToken) {
      headers['Authorization'] = `Bearer ${authToken}`;
    }
    
    // OpenResponses format: convert messages to input string
    const lastUserMessage = messageArray.filter((m: any) => m.role === 'user').pop();
    const inputText = lastUserMessage?.content || '';
    const requestBody = {
      model: `openclaw:${openclawAgentId}`,
      input: inputText,
      stream: stream || false,
    };
    
    console.log(`[Chat] Using gateway: ${url}`);
    
    console.log(`[Chat] Using model: ${effectiveModel}`);
    console.log(`[Chat] Request body:`, JSON.stringify(requestBody).slice(0, 500));

    // Add timeout to prevent hanging forever (55s - Vercel max is 60s)
    const controller = new AbortController();
    const timeoutId = setTimeout(() => {
      console.error(`[Chat] Request timeout after 55s to ${url}`);
      controller.abort();
    }, 55000); // 55 sec timeout (Vercel serverless max is 60s)
    
    let openclawResponse: Response;
    try {
      openclawResponse = await fetch(url, {
        method: 'POST',
        headers,
        body: JSON.stringify(requestBody),
        signal: controller.signal,
      });
    } catch (fetchError: any) {
      clearTimeout(timeoutId);
      console.error(`[Chat] Fetch failed: ${fetchError.name} - ${fetchError.message}`);
      // Specific error messages for common issues
      if (fetchError.name === 'AbortError') {
        return NextResponse.json(
          { error: `Gateway timeout: impossible de joindre ${gatewayUrl} (55s). Vérifiez que le gateway est accessible depuis Internet.` },
          { status: 504 }
        );
      }
      if (fetchError.cause?.code === 'ENOTFOUND') {
        return NextResponse.json(
          { error: `Gateway introuvable: ${gatewayUrl}. Vérifiez l'URL.` },
          { status: 502 }
        );
      }
      return NextResponse.json(
        { error: `Erreur réseau: ${fetchError.message}` },
        { status: 502 }
      );
    } finally {
      clearTimeout(timeoutId);
    }

    if (!openclawResponse.ok) {
      const errorText = await openclawResponse.text();
      console.error('[Chat] Gateway error:', errorText);
      return NextResponse.json(
        { error: `Gateway error: ${errorText}` },
        { status: openclawResponse.status }
      );
    }

    // Handle streaming response
    if (stream && openclawResponse.body) {
      const decoder = new TextDecoder();
      const encoder = new TextEncoder();
      
      let usageData: { model?: string; prompt_tokens?: number; completion_tokens?: number } = {};
      let buffer = '';
      let accumulatedContent = ''; // Track output for token estimation
      
      // Estimate input tokens from messages (rough: ~4 chars per token)
      const inputText = messageArray.map((m: any) => 
        typeof m.content === 'string' ? m.content : JSON.stringify(m.content)
      ).join(' ');
      const estimatedInputTokens = Math.ceil(inputText.length / 4);
      
      const transformStream = new TransformStream({
        async transform(chunk, controller) {
          buffer += decoder.decode(chunk, { stream: true });
          
          // Process complete lines
          const lines = buffer.split('\n');
          buffer = lines.pop() || ''; // Keep incomplete line in buffer
          
          for (const line of lines) {
            if (line.startsWith('data: ')) {
              const jsonStr = line.slice(6);
              
              if (jsonStr === '[DONE]') {
                controller.enqueue(encoder.encode('data: [DONE]\n\n'));
                continue;
              }
              
              try {
                const data = JSON.parse(jsonStr);
                
                // Anthropic format: { type: "content_block_delta", delta: { type: "text_delta", text: "..." } }
                if (data.type === 'content_block_delta' && data.delta?.text) {
                  accumulatedContent += data.delta.text;
                  // Convert to OpenAI format for frontend compatibility
                  const openaiFormat = {
                    choices: [{ delta: { content: data.delta.text } }],
                    model: effectiveModel,
                  };
                  controller.enqueue(encoder.encode(`data: ${JSON.stringify(openaiFormat)}\n\n`));
                }
                // Anthropic message_delta with usage
                else if (data.type === 'message_delta' && data.usage) {
                  usageData.completion_tokens = data.usage.output_tokens;
                }
                // Anthropic message_start with usage
                else if (data.type === 'message_start' && data.message?.usage) {
                  usageData.prompt_tokens = data.message.usage.input_tokens;
                  usageData.model = data.message.model;
                }
                // OpenAI format: { choices: [{ delta: { content: "..." } }] }
                else if (data.choices?.[0]?.delta?.content) {
                  accumulatedContent += data.choices[0].delta.content;
                  controller.enqueue(encoder.encode(`data: ${JSON.stringify(data)}\n\n`));
                }
                // OpenResponses format: response.output_text.delta event
                else if (data.type === 'response.output_text.delta' && data.delta) {
                  accumulatedContent += data.delta;
                  // Convert to OpenAI format for frontend compatibility
                  const openaiFormat = {
                    choices: [{ delta: { content: data.delta } }],
                    model: effectiveModel,
                  };
                  controller.enqueue(encoder.encode(`data: ${JSON.stringify(openaiFormat)}\n\n`));
                }
                // OpenResponses completed event with usage
                else if (data.type === 'response.completed' && data.response?.usage) {
                  usageData.prompt_tokens = data.response.usage.input_tokens;
                  usageData.completion_tokens = data.response.usage.output_tokens;
                  usageData.model = data.response.model;
                }
                
                // Capture model name (OpenAI format)
                if (data.model && !usageData.model) {
                  usageData.model = data.model;
                }
                
                // Capture usage if present (OpenAI format)
                if (data.usage?.prompt_tokens) {
                  usageData.prompt_tokens = data.usage.prompt_tokens;
                  usageData.completion_tokens = data.usage.completion_tokens;
                }
              } catch (e) {
                // Ignore parse errors for event lines
              }
            }
          }
        },
        async flush(controller) {
          // Filter NO_REPLY / HEARTBEAT_OK in streaming - don't send [DONE] if nothing useful
          const trimmedContent = accumulatedContent.trim();
          if (trimmedContent === 'NO_REPLY' || trimmedContent === 'HEARTBEAT_OK' || !trimmedContent) {
            // Send empty done - frontend should ignore
            controller.enqueue(encoder.encode('data: [DONE]\n\n'));
            return;
          }
          
          controller.enqueue(encoder.encode('data: [DONE]\n\n'));
          
          // Estimate output tokens if not provided (~4 chars per token)
          const estimatedOutputTokens = Math.ceil(accumulatedContent.length / 4);
          
          // Use actual usage if available, otherwise use estimates
          const inputTokens = usageData.prompt_tokens || estimatedInputTokens;
          const outputTokens = usageData.completion_tokens || estimatedOutputTokens;
          const modelToSave = usageData.model || effectiveModel;
          
          if (userId && (inputTokens > 0 || outputTokens > 0)) {
            console.log(`[Chat] Saving usage: model=${modelToSave}, input=${inputTokens}, output=${outputTokens} (estimated=${!usageData.prompt_tokens})`);
            await saveUsage(
              userId,
              modelToSave,
              inputTokens,
              outputTokens,
              channelKey,
              channelAgent?.id
            );
          }
        }
      });

      return new Response(openclawResponse.body.pipeThrough(transformStream), {
        headers: {
          'Content-Type': 'text/event-stream',
          'Cache-Control': 'no-cache',
          'Connection': 'keep-alive',
        },
      });
    }

    // Non-streaming response
    const data = await openclawResponse.json();
    
    // Save usage for non-streaming
    if (userId && data.usage) {
      await saveUsage(
        userId,
        data.model || effectiveModel,
        data.usage.input_tokens || data.usage.prompt_tokens || 0,
        data.usage.output_tokens || data.usage.completion_tokens || 0,
        channelKey,
        channelAgent?.id
      );
    }
    
    // Extract message - handle multiple response formats
    let message = '';
    
    // Anthropic format: { content: [{ type: "text", text: "..." }] }
    if (data.content && Array.isArray(data.content)) {
      for (const block of data.content) {
        if (block.type === 'text' && block.text) {
          message += block.text;
        }
      }
    }
    // OpenResponses format: { output: [{ content: [{ text: "..." }] }] }
    else if (data.output && Array.isArray(data.output)) {
      for (const item of data.output) {
        if (item.type === 'message' && item.content) {
          for (const part of item.content) {
            if (part.type === 'output_text' || part.type === 'text') {
              message += part.text || '';
            }
          }
        }
      }
    }
    // OpenAI format: { choices: [{ message: { content: "..." } }] }
    else if (data.choices?.[0]?.message?.content) {
      message = data.choices[0].message.content;
    }
    
    // Filter out NO_REPLY and empty responses - agent chose not to respond
    const finalContent = message || data.message || '';
    const trimmed = finalContent.trim();
    if (!trimmed || trimmed === 'NO_REPLY' || trimmed === 'HEARTBEAT_OK') {
      // Return empty 204 - frontend should not display anything
      return new Response(null, { status: 204 });
    }

    // Return in OpenAI format for compatibility with client
    return NextResponse.json({ 
      choices: [{
        message: {
          role: 'assistant',
          content: finalContent,
        }
      }],
      model: data.model || effectiveModel,
      usage: data.usage,
    });

  } catch (error: any) {
    console.error('[Proxy] Error:', error);
    // Provide more helpful error message
    let errorMessage = error.message || 'Proxy error';
    if (error.code === 'ECONNREFUSED' || error.message?.includes('fetch failed')) {
      errorMessage = 'Impossible de contacter le gateway OpenClaw. Vérifiez que votre gateway est en ligne et accessible.';
    } else if (error.name === 'AbortError') {
      errorMessage = 'Timeout - le gateway n\'a pas répondu dans les 2 minutes.';
    }
    return NextResponse.json(
      { error: errorMessage },
      { status: 500 }
    );
  } finally {
    // DISABLED: Queue system
    // if (typeof agentId !== 'undefined') {
    //   markAgentIdle(agentId);
    // }
  }
}

// Handle OPTIONS for CORS preflight
export async function OPTIONS() {
  return new Response(null, {
    status: 204,
    headers: {
      'Access-Control-Allow-Origin': '*',
      'Access-Control-Allow-Methods': 'POST, OPTIONS',
      'Access-Control-Allow-Headers': 'Content-Type, Authorization',
    },
  });
}
