# ===========================================
# EkyBot Environment Configuration
# ===========================================
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control!

# -------------------------------------------
# Supabase (REQUIRED)
# -------------------------------------------
# Get these from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# -------------------------------------------
# Database (REQUIRED)
# -------------------------------------------
# PostgreSQL connection string from Supabase
# Use connection pooling URL for serverless (port 6543)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&pool_timeout=10&connect_timeout=15

# Direct connection for migrations (port 5432)
DIRECT_URL=postgresql://postgres.YOUR_PROJECT:password@aws-0-region.pooler.supabase.com:5432/postgres

# -------------------------------------------
# AI Providers (at least one recommended)
# -------------------------------------------
ANTHROPIC_API_KEY=sk-ant-api...
OPENAI_API_KEY=sk-...

# Optional: Admin API keys for cost tracking
# ANTHROPIC_ADMIN_KEY=sk-ant-admin-...
# OPENAI_ADMIN_KEY=sk-admin-...

# -------------------------------------------
# Authentication
# -------------------------------------------
# Admin user ID (your Supabase auth user ID)
ADMIN_USER_ID=your_admin_user_id

# -------------------------------------------
# File Storage (optional)
# -------------------------------------------
# Vercel Blob for image/file uploads
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# -------------------------------------------
# Inter-Agent Communication (optional)
# -------------------------------------------
# Relay push for agent-to-agent messaging
# EKYBOT_RELAY_PUSH_URL=https://your-relay-endpoint.com
# EKYBOT_RELAY_PUSH_TOKEN=your_relay_token

# -------------------------------------------
# Agent Token (optional)
# -------------------------------------------
# Token for agent API authentication
# AGENT_TOKEN=your_agent_token

# -------------------------------------------
# Application
# -------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
